# Google Sheets live sync
#
# Steps to enable:
# 1. Open your "AI Outreach Tracker" Google Sheet
# 2. File → Share → Anyone with the link → Viewer
# 3. Copy the spreadsheet ID from the URL:
#    https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
# 4. Paste the full CSV export URL below:

SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/export?format=csv

# Expected sheet columns (row 1 = headers):
# id | name | industry | founded | size | revenue | location |
# contact_name | contact_title | contact_email |
# automation_ops  <-- pipe-separated: "op1|op2|op3"
# email_doc_url | status | automation_score |
# last_contacted | follow_up_date | notes
